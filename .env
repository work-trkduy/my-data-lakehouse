# ============ LAKEHOUSE STACK CONFIGURATION ============
# Shared credentials/config. Change freely — referenced across docker-compose.yml,
# scripts, flink-sql, and trino catalog props.

# --- Postgres source DB ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transactions_db

# --- Kafka / Debezium ---
KAFKA_BOOTSTRAP=kafka:9092
DEBEZIUM_TOPIC_PREFIX=postgres

# --- MinIO object storage ---
MINIO_ENDPOINT=http://minio:9000
# Endpoint Polaris vends in storage credentials. Because Flink/Trino run on
# the same bridge network, use the container-resolvable host (not localhost).
MINIO_EXTERNAL_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION=us-west-2
MINIO_BUCKET=warehouse

# --- Polaris (Iceberg REST catalog) ---
POLARIS_REALM=POLARIS
POLARIS_ROOT_USER=root
POLARIS_ROOT_PASSWORD=s3cr3t
POLARIS_CATALOG=quickstart_catalog

# --- Polaris metadata persistence (Postgres backend) ---
# Polaris 1.7.0 can persist its catalog metadata to Postgres via the
# relational-jdbc metastore backend instead of the in-memory store.
POLARIS_DB_NAME=polaris
POLARIS_DB_USER=polaris
POLARIS_DB_PASSWORD=polaris

# --- Monitoring (Prometheus + Grafana) ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin